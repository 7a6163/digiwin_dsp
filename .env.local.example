# Copy to .env.local (gitignored) and fill in real values.
# Do NOT commit .env.local.

# UAT 測試區 base URL: https://digiwindsp.digiwin.com/DSP_UAT
# Production base URL: https://digiwindsp.digiwin.com/DSP
DIGIWIN_DSP_ENV=sandbox

# Override base_url only if you need a non-default endpoint
# DIGIWIN_DSP_BASE_URL=https://digiwindsp.digiwin.com/DSP_UAT

DIGIWIN_DSP_API_KEY=
DIGIWIN_DSP_API_SECRET=

# Caller / platform identity used as `platform_id` and (by default) `site_no`
# inside request_detail. UAT example: acme_storefront_test
DIGIWIN_DSP_PLATFORM_ID=
